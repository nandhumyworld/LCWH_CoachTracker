# ---------------------------------------------------------------------------
# LCWH environment variables. Copy to .env.local for local dev.
# In Coolify, set these as service environment variables (do NOT commit .env).
# ---------------------------------------------------------------------------

# --- Database (Prisma) -----------------------------------------------------
# Local docker-compose provides this automatically (see docker-compose.yml).
# In production, paste the connection string of the Postgres DB you create in
# Coolify. Use the INTERNAL hostname Coolify gives the DB service.
DATABASE_URL="postgresql://lcwh:lcwh@localhost:5432/lcwh?schema=public"

# --- Auth.js (NextAuth v5) -------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
# Public base URL of the app. Local: http://localhost:3000
AUTH_URL="http://localhost:3000"

# --- OpenRouter (AI reports) ----------------------------------------------
OPENROUTER_API_KEY=""
# Fallback model if the Admin has not set one in the DB yet.
OPENROUTER_DEFAULT_MODEL="openai/gpt-4o-mini"

# --- Cron / n8n protection -------------------------------------------------
# n8n (or any scheduler) must send this as: Authorization: Bearer <secret>
# when calling /api/cron/* endpoints. Generate a long random value.
CRON_SECRET="replace-me-with-a-long-random-string"

# --- Image storage ---------------------------------------------------------
# Local disk backend for the MVP. This path is a mounted Docker volume.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="/data/uploads"
# Photo retention in days (retention-cleanup cron deletes older files).
PHOTO_RETENTION_DAYS="90"

# --- Branding (kept as data for future white-labeling) --------------------
NEXT_PUBLIC_APP_NAME="LifeChanging Wellness Hub"
NEXT_PUBLIC_APP_SHORT_NAME="LCWH"
